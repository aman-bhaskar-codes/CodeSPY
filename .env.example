# CodeSPY dependency setup template. Copy to ignored .env for local use.
# All real service/API keys are owner-managed and deliberately blank.
# The assistant must not configure keys or access the owner's AWS account.

# Application settings (no application code exists yet)
APP_NAME=CodeSPY
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local PostgreSQL and Redis: generate independent local passwords yourself
POSTGRES_USER=codespy
POSTGRES_PASSWORD=
POSTGRES_DB=codespy
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=

# Model APIs: owner will configure manually, no keys are generated during setup
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
CLAUDE_PRIMARY_MODEL=
CLAUDE_DEEP_REASONING_MODEL=
GEMINI_LONG_CONTEXT_MODEL=
GEMINI_FAST_TRIAGE_MODEL=
ANTHROPIC_REASONING_MODEL=
ANTHROPIC_FAST_MODEL=
GEMINI_CONTEXT_MODEL=
GEMINI_FAST_MODEL=

# Local search and installed tool locations
SEARXNG_BASE_URL=http://127.0.0.1:18080
SEARXNG_SECRET=
OSV_API_BASE_URL=https://api.osv.dev/v1
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSERS_PATH=
JAVA_HOME=
GHIDRA_INSTALL_DIR=
JADX_BIN_PATH=

# OAuth and repository access: manually configured by the owner
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PERSONAL_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application authentication: configure before application development
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_SECRET_KEY=
SESSION_SECRET=

# Local AWS emulator only; verification always uses explicit loopback endpoint
LOCALSTACK_ENDPOINT_URL=http://127.0.0.1:4566
S3_ARTIFACTS_BUCKET=codespy-artifacts-dev
SQS_ANALYSIS_QUEUE_NAME=codespy-analysis-jobs
SQS_ANALYSIS_DLQ_NAME=codespy-analysis-dlq

# Real AWS is owner-managed. Never put long-lived access keys here.
AWS_PROFILE=codespy
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=

# Optional observability, manually configured later
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=

# persistence database-only connection profile; optional URL takes precedence.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
DATABASE_MIGRATION_URL=
