{
  "name": "codespy",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "install:frontend": "npm --prefix frontend ci --ignore-scripts",
    "format:check": "prettier --check README.md docs .github",
    "format": "prettier --write README.md docs .github",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend test",
    "test:e2e": "npm --prefix frontend run test:e2e"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
